# SnapTray environment template (thesis review friendly)
# Copy this file to .env and replace placeholders with real values.
# Never commit real secrets.
# Keep variable names exactly as written. The code expects these names.
# This template mirrors the real .env key set, but uses safe placeholders.

# ------------------------------------------------------------
# 1) Application runtime and cookie behavior
# ------------------------------------------------------------
# Used in: src/main.js
PORT=3000

# Used in: src/middleware/security.js
HOST=http://localhost:3000
PRODUCTION_HOST=https://your-domain.example
PRODUCTION_HOST_2=https://www.your-domain.example

# Used in: src/main.js
SESSION_SECRET=change_me_to_a_long_random_secret
SESSION_COOKIE_SECURE=false

# Used in: src/middleware/security.js
CSRF_COOKIE_SECURE=false

# ------------------------------------------------------------
# 2) Database and cache
# ------------------------------------------------------------
# Used in: config/database_queries.js, tests/*
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=Projekt_vizsgaremek

# Used in: src/redis.js
REDIS_HOST=redis://localhost:6379

# ------------------------------------------------------------
# 3) Authentication and security secrets
# ------------------------------------------------------------
# Used in: src/auth/login.js, src/auth/2fa.js
JWT_LOGIN_SECRET=change_me_login_secret
JWT_2FA_SECRET=change_me_2fa_secret

# Used in: src/auth/email_verification.js, src/auth/password_reset.js
JWT_EMAIL_SECRET=change_me_email_secret
JWT_SECRET=change_me_password_reset_secret

# Used in: src/auth/security.js
IP_HASH_SECRET=change_me_ip_hash_secret

# ------------------------------------------------------------
# 4) Email and verification services
# ------------------------------------------------------------
# Used in: src/auth/email_verification.js, src/auth/password_reset.js
EMAIL_USER=your_verified_sender@example.com
EMAIL_PASS=your_email_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDGRID_API_KEY=SG_xxx

# ------------------------------------------------------------
# 5) Payment provider configuration
# ------------------------------------------------------------
# Used in: src/Orders/Order.js, src/services/paypal-service.js, src/dashboard/admin/admin.js
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ------------------------------------------------------------
# 6) Anti-bot and geo checks
# ------------------------------------------------------------
# Used in: frontend registration flow (public side)
# NOTE: The name is intentionally kept as Client_Side_Captha for compatibility.
Client_Side_Captha=your_recaptcha_site_key

# Used in: src/auth/register.js
# NOTE: The name is intentionally kept as Server_Side_Captha for compatibility.
Server_Side_Captha=your_recaptcha_secret

# Used in: src/auth/login.js
# IPLocate API key for geo-IP lookup and login risk scoring
GEOIP=your_ip_locate_api_key

# ------------------------------------------------------------
# 7) Load testing (optional)
# ------------------------------------------------------------
# Used by: tests/performance tooling (Artillery cloud/local integration)
ARTILLERY_API_KEY=your_artillery_api_key
